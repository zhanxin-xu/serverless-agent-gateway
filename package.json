{
  "name": "serverless-agent-gateway",
  "version": "0.1.0",
  "description": "Multi-channel AI chatbot gateway on Vercel Functions: QQ / Telegram / HTTP webhooks -> tool-calling agent loop -> reply",
  "keywords": [
    "vercel",
    "serverless",
    "webhook",
    "chatbot",
    "agent",
    "qq-bot",
    "telegram-bot",
    "openrouter",
    "responses-api"
  ],
  "homepage": "https://serverless-agent.cnday.cn",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/zhanxin-xu/serverless-agent-gateway.git"
  },
  "bugs": {
    "url": "https://github.com/zhanxin-xu/serverless-agent-gateway/issues"
  },
  "scripts": {
    "dev": "tsx watch deploy/node/server.ts",
    "start": "tsx deploy/node/server.ts",
    "typecheck": "tsc --noEmit",
    "test": "tsx scripts/selftest.ts && tsx scripts/moduletest.ts",
    "test:store": "tsx scripts/storetest.ts",
    "test:load": "tsx scripts/loadtest.ts"
  },
  "license": "MIT",
  "dependencies": {
    "@vercel/functions": "^3.10.6",
    "@vercel/sandbox": "^3.9.1",
    "pg": "^8.23.1",
    "sharp": "^0.35.5",
    "silk-wasm": "^3.7.1"
  },
  "devDependencies": {
    "@types/node": "^24.19.2",
    "@types/pg": "^8.23.1",
    "tsx": "^4.23.15",
    "typescript": "5.9"
  },
  "private": true,
  "type": "module",
  "engines": {
    "node": "24.x"
  },
  "overrides": {
    "zod": "^4.6.7"
  }
}
