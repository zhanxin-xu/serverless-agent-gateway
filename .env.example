# ── Admin console (/admin). Environment only. ──
# Everything below can instead be set in the console, stored in the database
# (console → environment → default). This password signs in to the console.
ADMIN_PASSWORD=
# How chats seen for the first time are answered: normal | mention | record | block
# CHAT_DEFAULT_MODE=normal
# Each optional module has a switch: MODULE_MEMORY, MODULE_SEARCH, MODULE_SANDBOX, MODULE_IMAGE, MODULE_VOICE (on | off)

# ── Model, through pi-ai: one instance per endpoint, settings MODEL_{INSTANCE}_… ──
# Instances: OPENROUTER (default), OPENAI, ANTHROPIC, GEMINI, DEEPSEEK, CUSTOM; each has its own key.
# MODEL_PROVIDER picks one (unset: the one configured). Protocols: openai-responses |
# openai-completions | anthropic-messages | google-generative-ai; the base URL is the protocol's root.
# MODEL_PROVIDER=openrouter
# MODEL_OPENROUTER_API=openai-responses
MODEL_OPENROUTER_API_KEY=
MODEL_OPENROUTER_BASE_URL=https://openrouter.ai/api/v1
MODEL_OPENROUTER_MODEL=openai/gpt-6-luna
# JSON object merged into every request body, in the protocol's own field names. OpenRouter provider locking:
MODEL_OPENROUTER_EXTRA_BODY={"provider":{"only":["openai"],"allow_fallbacks":false}}
# Optional extra request headers (JSON object)
# MODEL_OPENROUTER_EXTRA_HEADERS={"HTTP-Referer":"https://example.com","X-Title":"serverless-agent-gateway"}
# Output cap per call, reasoning included (unset: only Anthropic gets one, 32000)
# MODEL_OPENROUTER_MAX_OUTPUT_TOKENS=
# MODEL_TIMEOUT_MS=280000
# Another endpoint, e.g. Anthropic:
# MODEL_ANTHROPIC_API_KEY=
# MODEL_ANTHROPIC_MODEL=

# ── Image generation (generate_image): POST {IMAGE_OPENROUTER_BASE_URL}/images. Hidden when the key is empty. ──
IMAGE_OPENROUTER_API_KEY=
# IMAGE_OPENROUTER_BASE_URL=https://openrouter.ai/api/v1
# IMAGE_OPENROUTER_MODEL=openai/gpt-image-2.6-sunburst
# IMAGE_OPENROUTER_QUALITY=low
# For models that support it (gpt-image doesn't): 512 | 768 | 1K | 1.5K | 2K | 4K
# IMAGE_OPENROUTER_RESOLUTION=
# IMAGE_OPENROUTER_EXTRA_BODY={"provider":{"options":{"openai":{"moderation":"low"}}}}
# IMAGE_OPENROUTER_TIMEOUT_MS=180000
# The persona's picture, sent as a reference when she draws herself (include_self); "none" turns it off
# IMAGE_SELF_REFERENCE=assets/persona/dafeiyu.webp   (relative to packages/vercel/)
# Or OpenAI's own Image API (IMAGE_PROVIDER=openai when both are set): /images/generations and /images/edits.
# IMAGE_OPENAI_API_KEY=
# IMAGE_OPENAI_MODEL=gpt-image-2.6-sunburst
# IMAGE_OPENAI_QUALITY=low

# ── Pricing: calls that report only tokens are priced by resources/pricing/model-prices.json ──
# PRICE_CNY_PER_USD=7.1   (CNY-priced entries, e.g. DeepSeek, converted to USD at this rate)

# ── Spending limits per module, every chat together, in USD (docs/configuration.md#花费上限). Empty = no limit. ──
# MODEL_DAILY_BUDGET_USD=
# MODEL_MONTHLY_BUDGET_USD=
# IMAGE_DAILY_BUDGET_USD=
# IMAGE_MONTHLY_BUDGET_USD=

# ── Voice (send_voice): POST {VOICE_OPENROUTER_BASE_URL}/audio/speech. Hidden when the key is empty. ──
VOICE_OPENROUTER_API_KEY=
# VOICE_OPENROUTER_BASE_URL=https://openrouter.ai/api/v1
# fish-audio/drama-3 (default) or bytedance-seed/seed-audio-1-0; the agent can't change it
# VOICE_OPENROUTER_MODEL=fish-audio/drama-3
# The voice to clone (a file in the deployment or an https URL; "none" = no cloning) and what it says
# VOICE_OPENROUTER_REFERENCE_AUDIO=assets/voice/dafeiyu.mp3   (relative to packages/vercel/)
# VOICE_OPENROUTER_REFERENCE_TEXT=
# Optional clip of the same voice singing (offered as voice "self_sing") and its words
# VOICE_OPENROUTER_SING_REFERENCE_AUDIO=
# VOICE_OPENROUTER_SING_REFERENCE_TEXT=
# VOICE_OPENROUTER_VOICE=
# VOICE_OPENROUTER_INSTRUCTIONS=软萌可爱的小女孩
# VOICE_OPENROUTER_EXTRA_BODY={"speed":1.1}
# VOICE_OPENROUTER_TIMEOUT_MS=120000

# ── Web search / fetch tools (DeepSeek tool API). Tools are hidden when empty. ──
SEARCH_DEEPSEEK_API_KEY=
# SEARCH_DEEPSEEK_BASE_URL=https://api.deepseek.com

# ── Agent ──
# AGENT_TIMEZONE=Asia/Shanghai   # time zone of the [time｜scene｜sender] line on each message
AGENT_MAX_STEPS=40
# Vercel: must match maxDuration in packages/vercel/vercel.json; with < 100s left a run hands the turn to a fresh /api/worker
# AGENT_MAX_DURATION_SECONDS=300
# Context budget in tokens; past 80% of it, older events are summarized
AGENT_CONTEXT_TOKENS=200000
# Ordinary (non-@) group messages, when GROUP_MESSAGE_CREATE is subscribed:
AGENT_AMBIENT_INTERVAL_SECONDS=10  # wake the agent at most once per group per window; 0 = log only

# ── QQ Bot (q.qq.com) ──
QQ_APP_ID=
QQ_APP_SECRET=

# ── Telegram ──
TELEGRAM_BOT_TOKEN=
TELEGRAM_WEBHOOK_SECRET=
# Without @; required for the bot to answer in groups (only when mentioned)
TELEGRAM_BOT_USERNAME=

# ── Generic HTTP channel (disabled when empty) ──
HTTP_CHANNEL_TOKEN=

# ── Store: sessions, event logs, images (Supabase; run packages/adapters/src/supabase/schema.sql first). Memory when empty. ──
# Injected by the Vercel Marketplace Supabase integration:
SUPABASE_URL=
SUPABASE_SECRET_KEY=
# Direct connection, for creating / upgrading the tables from the console (also injected):
# POSTGRES_URL_NON_POOLING=   (DATABASE_URL or POSTGRES_URL also work)

# ── Long-term memory (Upstash Vector, shared by every chat). Disabled when empty. ──
# Create the index with the hosted embedding model (text-embedding-3-small, 1536 dims).
UPSTASH_VECTOR_REST_URL=
UPSTASH_VECTOR_REST_TOKEN=

# ── Sandbox workspace (Vercel Sandbox + one Drive per chat) ──
# On by default on Vercel (OIDC); locally needs VERCEL_OIDC_TOKEN from `vercel env pull`.
# Which provider each module uses (docs/modules.md). Empty = the one configured.
# SEARCH_PROVIDER=deepseek
# VOICE_PROVIDER=openrouter
# IMAGE_PROVIDER=openrouter   (or openai)
# MEMORY_PROVIDER=upstash
# SANDBOX_PROVIDER=vercel
# SANDBOX_VERCEL_ENABLED=0
# SANDBOX_VERCEL_REGION=iad1
# SANDBOX_COMMAND_TIMEOUT_SECONDS=60

# ── Stickers ──
# Defaults to the 梗鲸 archive CDN root; set to serve your own copies (same paths: meme/NNN.gif, 0_preview/meme/NNN.webp)
# STICKER_BASE_URL=https://img.aigengtu.com
