{
  "name": "serverless-agent-gateway",
  "version": "0.1.0",
  "description": "Multi-channel AI chatbot gateway: QQ / Telegram / HTTP webhooks -> tool-calling agent loop -> reply. Core, adapters and a Vercel deployment as npm workspaces.",
  "keywords": [
    "vercel",
    "serverless",
    "webhook",
    "chatbot",
    "agent",
    "qq-bot",
    "telegram-bot",
    "openrouter",
    "responses-api"
  ],
  "homepage": "https://serverless-agent.cnday.cn",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/zhanxin-xu/serverless-agent-gateway.git"
  },
  "bugs": {
    "url": "https://github.com/zhanxin-xu/serverless-agent-gateway/issues"
  },
  "license": "MIT",
  "private": true,
  "type": "module",
  "workspaces": [
    "packages/core",
    "packages/adapters",
    "packages/vercel"
  ],
  "scripts": {
    "dev": "npm run dev -w @gateway/vercel",
    "build": "npm run build -w @gateway/core && npm run build -w @gateway/adapters",
    "typecheck": "tsc --noEmit",
    "test": "tsx --conditions=source scripts/selftest.ts && tsx --conditions=source scripts/moduletest.ts && tsx --conditions=source scripts/llmtest.ts",
    "test:store": "tsx --conditions=source scripts/storetest.ts && tsx --conditions=source scripts/migrationtest.ts",
    "test:load": "tsx --conditions=source scripts/loadtest.ts"
  },
  "devDependencies": {
    "@types/node": "^24.19.2",
    "@types/pg": "^8.23.1",
    "tsx": "^4.23.15",
    "typescript": "5.9"
  },
  "engines": {
    "node": "24.x"
  },
  "overrides": {
    "zod": "^4.6.7"
  }
}
